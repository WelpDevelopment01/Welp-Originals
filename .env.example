# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP Email Configuration:
# Required to send real emails to welpdrinks.desk@gmail.com and the pre-ordering users.
# You can use standard Gmail App Passwords or custom SMTP providers.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="welporiginals@gmail.com"
SMTP_PASS=""
SMTP_FROM="YOLO Soda <welporiginals@gmail.com>"

# Alternate Google Services Email Config (Zero 2-Step Verification & No Password Needed):
# Paste your deployed Google Apps Script Web App URL here to dispatch emails autonomously 
# from your own personal or workspace Google Account with zero SMTP passwords or App Passwords.
GOOGLE_SCRIPT_URL="https://script.google.com/macros/s/AKfycbwGbETi4P_X7gQVXPNQQKWS5xcx9WR4ECUf-c2GRCcoxZdLFjppsLWn5eLFVH83tao1/exec"
